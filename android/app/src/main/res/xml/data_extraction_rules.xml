<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: progress goes along to a new phone (cloud backup and device transfer). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/" />
        <exclude domain="root" path="app_webview/Default/Cache/" />
        <exclude domain="root" path="app_webview/Default/Code Cache/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/" />
        <exclude domain="root" path="app_webview/Default/Cache/" />
        <exclude domain="root" path="app_webview/Default/Code Cache/" />
    </device-transfer>
</data-extraction-rules>
