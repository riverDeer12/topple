<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A light theme makes the web view report prefers-color-scheme: light (values-night: dark). -->
    <style name="Theme.Topple" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
